# Copy to .env and fill in real credentials when leaving simulation mode.

# Simulation mode needs no API key or MT5 terminal.
SIMULATE=true
USE_MOCK_LLM=true

# Real LLM (DeepSeek/OpenAI-compatible)
DEEPSEEK_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# True vision API (optional): model must accept image inputs.
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# MT5 live/paper account
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_MAGIC=888888

# Trading settings
SYMBOL=XAUUSD
TIMEFRAME=H1
# V5 universe: SYMBOL:TIMEFRAME pairs separated by semicolons.
# SYMBOL/TIMEFRAME stay as defaults for demo/analyze/backtest.
TRADING_UNIVERSE=XAUUSD:H1;XAUUSD:M15;EURUSD:H1;GBPUSD:H1;USDJPY:H1
INITIAL_BALANCE=10000
MAX_RISK_PERCENT=0.01
# Reject ultra-tight stops that are not anchored to ATR/structural distance.
ENABLE_MIN_STOP_ATR_GUARD=true
MIN_STOP_ATR_MULTIPLIER=0.5
# Max add-on orders allowed on the same symbol beyond the original position.
MAX_ADDONS_PER_SYMBOL=1
# Reject entries when the 0.01-lot floor makes the real stop-loss risk larger
# than MAX_RISK_PERCENT (plus the tolerance below).
ENABLE_MIN_LOT_RISK_GUARD=true
# Rounding overshoot allowed above MAX_RISK_PERCENT; 0.5 means 50%.
MIN_LOT_RISK_TOLERANCE=0.5
DAILY_LOSS_LIMIT=0.03
MAX_LOSS_STREAK=5
MAX_OPEN_POSITIONS=3
MIN_CONFIDENCE=70
DEFAULT_RR=2.0
ENABLE_VISION_GUARD=false
ENABLE_EXTREME_GUARD=true
# AI decisions run once per closed chart bar; TP/SL management still runs every cycle.
ENABLE_BAR_CLOSE_DECISIONS=true
# Wake the AI mid-bar when the price range since the last decision reaches 0.8 x ATR.
DECISION_WAKE_ATR_MULTIPLE=2.0
# off | position | range | position_range - mid-bar AI wake mode
MID_BAR_WAKE_MODE=range
# Macro is a direction/context reference, not a hard trade lock.
ENABLE_MACRO_GATE=false
ENABLE_TREND_CONFLICT_GUARD=true
ENABLE_RULE_VETO=false
RULE_VETO_GAP=2
RULE_VETO_MASK=base,structure,rsi,cci,macd,ict
# BOS/CHoCH/Trend Health context-only readout.
STRUCTURE_SWING_LEN=10
TREND_HEALTH_WEAK_LEVEL=40
# RSI divergence and tested key-level readouts (context only).
RSI_DIVERGENCE_PIVOT_LEN=10
RSI_DIVERGENCE_MAX_DISTANCE=60
DIVERGENCE_VALID_BARS=20
CCI_LENGTH=20
CCI_DIVERGENCE_EXTREME=150
CCI_DIVERGENCE_MAX_DISTANCE=60
KEY_ZONE_SWING_LEN=10
KEY_ZONE_ATR=0.75
ICT_SWEEP_LOOKBACK=20
ICT_FVG_LOOKBACK=30

# Live finance headlines for macro context (sina/wallstreetcn).
NEWS_ENABLED=true
NEWS_FETCH_TIMEOUT=8
NEWS_MAX_ITEMS=12
MACRO_CACHE_SECONDS=300

# Alerts (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
